# Copia este archivo como `.env` y cambia las claves antes de levantar nada.
# `.env` está en .gitignore: nunca se versiona.
#
#   cp .env.example .env
#
# Para generar claves de verdad:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Base de datos ------------------------------------------------------
POSTGRES_USER=algebra
POSTGRES_PASSWORD=cambia-esta-clave-de-postgres
POSTGRES_DB=algebra

# --- API ----------------------------------------------------------------
# dev | test | prod
ENTORNO=dev
# Firma los tokens JWT. Mínimo 32 caracteres (RFC 7518 §3.2 para HS256).
SECRET_KEY=cambia-esta-clave-secreta-de-al-menos-32-caracteres

# --- Usuario del laboratorio -------------------------------------------
# El que pide el enunciado de la asignatura. Se crea en el primer arranque;
# cambiarlo después NO modifica el usuario ya existente en la base.
USUARIO_INICIAL=nico
PASSWORD_INICIAL=1234

# --- Interfaz -----------------------------------------------------------
# Firma la cookie de sesión de NiceGUI. Mínimo 16 caracteres.
STORAGE_SECRET=cambia-esta-clave-de-sesion-de-nicegui

# --- Puertos publicados en el host --------------------------------------
PUERTO_WEB=8080
PUERTO_API=8000
